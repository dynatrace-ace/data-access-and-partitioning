{
  "enabled": true,
  "name": "part2_service_availability",
  "metricName": "part2_service_availability",
  "metricExpression": "(100)*(builtin:service.errors.server.successCount:splitBy())/(builtin:service.requestCount.server:splitBy())",
  "evaluationType": "AGGREGATE",
  "filter": "",
  "evaluationWindow": "-1w",
  "targetSuccess": 99.98,
  "targetWarning": 99.99,
  "errorBudgetBurnRate": {
    "burnRateVisualizationEnabled": true,
    "fastBurnThreshold": 10.0
  }
}